  finding_02_handler_insertion_point=CORRECT
    detail: STEP 2a après validation format, avant council_decision
    raison: Sécurité > validation > routage (hiérarchie correcte)
    error_codes: E306/E307 (format), signature_rejected (sécurité)
    esta_correct: Oui

  finding_03_registry_enforcement=ASYMMETRIC
    detail: Signature ONLY obligatoire pour agents enregistrés avec public_key
    consequence: agent_register nécessite signature (bootstrap)
    limitation_honnête: Pas de rotation de clé (v1)
    pero: Pas grave, cas d'usage early-stage ne le demande pas

