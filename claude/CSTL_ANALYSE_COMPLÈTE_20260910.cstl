RELATION_LINGUISTIQUE_01_BACKWARD_COMPATIBILITY
  relation_type=protocol_evolution
  component=CSTL_v5.0.0_to_v5.0.0_signing
  aspect=wire_format_change
  compatibility_level=FULL_BACKWARD_COMPATIBLE
  confidence=1.00

  change_1: META.public_key introduced (optional, 64 hex chars)
  impact: Ancien parser ignore → OK
  non_breaking: Yes

  change_2: INTENT_PAYLOAD.signature introduced (optional, 128 hex chars)
  impact: Ancien parser ignore → OK
  non_breaking: Yes

  change_3: Validation E306/E307 (hex format errors)
  impact: Nouveau parser rejette, ancien accepterait
  direction: Stricter validation — acceptable car non-signé reste OK
  non_breaking: Oui pour production payloads

  test_retrocompat: Tous 148 tests avant passent sans modification
  regression_payload_unsigned_untouched: PASS

RELATION_LINGUISTIQUE_02_CANONICALISATION_SEMANTICS
  relation_type=semantic_preservation
  component=signing_bytes_algorithm
  aspect=information_content
  preservation_guarantee=EXACT

  canonicalisation_rules:
    rule_1_nfc_unicode: NFC normalization on all values
      example: "Alïce" → canonical form (compose/decompose unique)
      property: Idempotent (apply twice = apply once)
      cross_language: Python unicodedata + Rust unicode-normalization
      test_result: IDENTICAL byte-for-byte

    rule_2_btreemap_sort: Alphabetical sort on all keys
      example: {z:val, a:val, encoder:val} → {a:val, encoder:val, z:val}
      property: Deterministic (always same order)
      justification: Signature musn't depend on transmission order

    rule_3_field_exclusions: PARENT_HASH + signature excluded
      reason_parent_hash: Circular reference (payload_N already chains payload_N-1)
      reason_signature: Signature can't sign itself
      inclusion_public_key: YES — ties signature to claimed key
      test_coverage: 3 exclusion tests

  example_canonicalisation:
    input: {z:Z, meta:{pk:KEY, unused:VAL}, intent:{sig:SIG, msg:MSG}}
    step_1_exclude: {z:Z, meta:{pk:KEY}, intent:{msg:MSG}}
    step_2_nfc: Apply NFC to each value
    step_3_sort: {intent:{msg:MSG}, meta:{pk:KEY}, z:Z}
    output_bytes: "intent.msg=MSG\nmeta.pk=KEY\nz=Z\n" (UTF-8)

RELATION_LINGUISTIQUE_03_SCHEMA_EXTENSIBILITY
  relation_type=format_design
  component=CSTL_meta_block_structure
  aspect=future_evolution
  extensibility_rating=GOOD

  current_meta_fields=
    encoder, produced_by, public_key (new), PARENT_HASH, timestamp, etc.

  addition_mechanism=
    New META fields simply added as "META key=value" lines
    Canonical hash unaffected (lexicographic sort handles new keys)
    Backward compat: Old parser ignores unknown keys
    Example: Adding META monitoring_agent=X costs 0 breaking changes

  pero_franche:
    CSTL spec (comme JSON Schema) manque formal evolution policy
    Aujourd'hui: Ad-hoc additions work, pas de versioning strategy
    v6.0.0: Formalize deprecation + version fields

