## FEATURE C — sdk/python/cstl_llm_agent.py (Agent LLM Python)

PYTHON_LLM_AGENT [
  status=Fully_Implemented,
  verification=Structural_Only_This_Sandbox,
  live_verification=User_Machine_Required,
  compatibility=New_Module
]

### Architecture du Module

PYTHON_AGENT_STRUCTURE [
  file="sdk/python/cstl_llm_agent.py",
  lines_of_code=~300,
  dependencies=["cryptography.hazmat.primitives.asymmetric.ed25519", "json", "socket", "os"]
]

CORE_FUNCTIONS [
  load_or_create_keypair="Crée ou charge une paire Ed25519",
  cstl_signing_bytes="Port EXACT Rust → Python (octet par octet)",
  sign_intent="Signe un payload avec la clé privée",
  register_agent="Envoie un purpose=agent_register avec auto-signature",
  AnthropicAgentBrain_from_env="Retourne None proprement si anthropic absent ou clé manquante",
  run_llm_relay="Boucle d'alternance : LLM côté Python, stdin côté humain"
]

### Point Critique : Byte-for-Byte Signing

SIGNING_BYTES_PORTING [
  risk="Critique — toute dérive casse silencieusement TOUTES les signatures Python",
  implementation="cstl_signing.py (import en interne)",
  verification="Test croisé Rust/Python sur payload fixe (seule partie réellement vérifiable en sandbox)"
]

CANONICAL_TRANSFORMATION [
  nfc_normalization="Rust → NFC (normalization form composed)",
  btreemap_sort="Rust → ordonnancement lexicographique des clés",
  exclusions="PARENT_HASH, signature, rotation_signature",
  includes="public_key (liée à la signature revendiquée)"
]

### Dégradation Propre : from_env()

ANTHROPIC_AGENT_BRAIN [
  design_pattern="Même patron que TelegramNotifier::from_env()",
  behavior=[
    "Tente d'importer 'anthropic'",
    "Si absent → None (pas d'exception, pas de fallback factice)",
    "Tente de charger ANTHROPIC_API_KEY",
    "Si absent → None",
    "Sinon → AnthropicAgentBrain(api_key=...)"
  ],
  sandbox_result="None (pas d'anthropic, pas de clé — normal ici)"
]

RELAY_ARCHITECTURE [
  constraint="Serveur TCP strictement requête/réponse par connexion",
  consequence="Deux agents indépendants ne peuvent pas se recevoir mutuellement des messages non sollicités",
  solution="Un seul processus, tours alternés (comme cstl_orchestrator.py::run_relay)",
  message_source_1="LLM (AnthropicAgentBrain.query())",
  message_source_2="stdin (input() ou second AnthropicAgentBrain)"
]

PAYLOAD_BUILDING [
  method="Réutilise CstlClient.build_payload(extra_meta=..., extra_intent=...)",
  changes_to_sdk="Aucune modification de cstl_client.py",
  wire_format="Même format CSTL v5.0.0 que côté Rust"
]

### Vérification en Sandbox vs Machine de l'Utilisateur

SANDBOX_VERIFICATION [
  syntactic_check="✅ Compilation Python sans erreur",
  cross_test="✅ signing_bytes(payload) reproduit le Rust octet par octet",
  from_env_check="✅ AnthropicAgentBrain.from_env() retourne None proprement",
  live_response="❌ Impossible — pas d'anthropic, pas de clé"
]

USER_MACHINE_VERIFICATION [
  prerequisite_1="pip install anthropic",
  prerequisite_2="export ANTHROPIC_API_KEY=sk-...",
  start_server="cargo run --release",
  run_agent="python3 sdk/python/cstl_llm_agent.py --peer-mode stdin",
  validate=[
    "Réponse réelle générée par le modèle",
    "Signée avec la clé privée de l'agent",
    "Enregistrée via purpose=agent_register",
    "Hashes d'audit correctement chaînés",
    "Purpose=detect_emergence détecte les divergences si plusieurs agents"
  ]
]

