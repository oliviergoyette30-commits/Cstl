## FEATURE A — Signature Ed25519 (Couche 2 / Sécurité)

SIGNATURE_IMPLEMENTATION [
  status=Fully_Implemented,
  verification=Complete,
  test_coverage=13_new_tests_passing,
  compatibility=Backward_Compatible
]

### Qu'est-ce qui a changé ?

BEFORE_STATE [
  sender_receiver=Plain_Text_Strings,
  verification=None,
  risk=OWASP_ASI03_ASI07_Identity_Privilege_Abuse
]

AFTER_STATE [
  cryptography=Ed25519_Signatures,
  wire_format=[
    "META.public_key=<hex_64_chars>",
    "INTENT_PAYLOAD.signature=<hex_128_chars>"
  ],
  verification=Byte_by_Byte_Validation,
  security_closes=OWASP_Agentic_Top_10_ASI03_ASI07
]

### Architecture Décision Cruciale

DESIGN_PRINCIPLE [
  optionality=Global,
  enforcement=Selective,
  rule="Optionnelle globalement, obligatoire SEULEMENT pour un expéditeur déjà enregistré avec une public_key"
]

RATIONALE [
  reason1="Préserve tous les 269 tests existants non signés",
  reason2="Les binaires smoke-test alice/bob continuent de fonctionner",
  reason3="Ferme le VRAI risque (usurper une identité CONNUE) pas un risque théorique",
  risk_closed="Impossible de se prétendre être un agent enregistré sans sa clé privée"
]

### Implémentation Technique

SIGNING_MODULE [
  location="src/signing.rs",
  lines_of_code=126,
  functions=[
    "check_signature(payload: &CstlPayload) -> SignatureCheck",
    "check_rotation_signature(payload: &CstlPayload, old_public_key_hex: &str) -> SignatureCheck",
    "verify_raw(message, public_key_hex, signature_hex) -> SignatureCheck"
  ]
]

SIGNATURE_CHECK_ENUM [
  NotPresent="Ni public_key ni signature ne sont présents — accepté sauf si enregistré",
  Valid="Signature vérifiée avec la clé publique revendiquée",
  Invalid="Raison : invalid_hex, bad_public_key_length, bad_signature_length, verification_failed"
]

HANDLER_INTEGRATION [
  step="STEP 2a (juste après validation, avant council_decision)",
  placement="Couche 2 security, avant la logique consultatif",
  behavior=[
    "Invalid(reason) → purpose=signature_rejected",
    "NotPresent + registered_with_public_key → purpose=signature_rejected (missing_signature_for_registered_agent)",
    "Valid → continue to next step"
  ]
]

SIGNING_BYTES_LOGIC [
  file="src/server/audit.rs",
  canonicalization="NFC + BTreeMap sort (même logique que canonical_hash)",
  includes=[
    "META (sauf PARENT_HASH)",
    "INTENT (sauf signature et rotation_signature)",
    "public_key (lie la signature à la clé revendiquée)"
  ],
  excludes=["PARENT_HASH", "signature", "rotation_signature"],
  importance="Dérive cryptographique = silencieuse rupture"
]

DEPENDENCIES [
  added=["ed25519-dalek = 2", "hex = 0.4"],
  justification="Dalek : cryptographie mûre et audité; hex : manipulation d'octets bruts [u8;N]"
]

### Tests et Vérification

SIGNATURE_TESTS [
  total_new_tests=13,
  passing=13,
  test_cases=[
    "test_valid_signature_verifies",
    "test_signature_from_wrong_key_fails",
    "test_tampered_payload_fails_verification",
    "test_invalid_hex_public_key",
    "test_wrong_length_public_key",
    "test_wrong_length_signature",
    "test_no_signature_fields_is_not_present",
    "test_only_public_key_no_signature_is_invalid",
    "test_only_signature_no_public_key_is_invalid",
    "test_rotation_signature_valid_with_old_key",
    "test_rotation_signature_from_wrong_old_key_fails",
    "test_rotation_signature_tampered_payload_fails",
    "test_rotation_signature_absent_is_not_present"
  ],
  production_path_verified=true,
  tcp_end_to_end_verified=true
]

