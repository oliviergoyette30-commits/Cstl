## FEATURE B-1 — Registre Mutable + Identité sur AgentCard

REGISTRY_MUTATION [
  status=Fully_Implemented,
  verification=Complete,
  test_coverage=2_new_tests_passing,
  compatibility=Backward_Compatible
]

### Architecture Change

BEFORE_STATE [
  agent_registry=Arc_AgentRegistry_Immutable,
  agent_definition_time=Compile_Time,
  agents_in_main_rs=["alice", "bob"],
  bootstrap=Hard_Coded,
  duplication_risk=High
]

AFTER_STATE [
  agent_registry=Arc_Mutex_AgentRegistry_Mutable,
  agent_definition_time=Runtime,
  bootstrap_seed=["alice", "bob"],
  dynamic_registration=enabled,
  duplication_strategy=Upsert_By_Name
]

### Changements Clés

AGENT_CARD_EVOLUTION [
  added_field="public_key: Option<String>",
  field_purpose="Identity cryptographique (hex, 64 caractères = 32 octets Ed25519)",
  default_legacy="None (alice/bob non signés)",
  new_agents="Some(hex_key) après registration via purpose=agent_register"
]

REGISTRY_REGISTER_METHOD [
  before="push(card) — doublons possibles",
  after="upsert par nom — remplace l'entrée existante si le nom correspond",
  consequence="route() (max par trust_score) reste cohérent, pas de fantôme",
  necessity="Obligatoire dès que l'enregistrement devient dynamique"
]

THREADING_ARCHITECTURE [
  pattern="Même schéma que adn_store et governance déjà en place",
  flow=["server/mod.rs", "listener.rs", "handler.rs"],
  concurrency=[
    "STEP 4 (registry.route) passe par registry.lock().await.route(...)",
    "Clone du nom d'agent AVANT de libérer le lock",
    "Ne pas tenir le lock pendant write_all().await"
  ]
]

### Tests et Vérification

REGISTRY_TESTS [
  test_cases=[
    "test_agent_discovery",
    "test_register_is_upsert_by_name_not_duplicate"
  ],
  key_assertion="registry.agents.len() == 1 après reenregistrement (pas de duplication)"
]

