## FEATURE B-2 — purpose=agent_register (Enregistrement Dynamique)

AGENT_REGISTRATION [
  status=Fully_Implemented,
  verification=Complete,
  test_coverage=Integrated_Into_Handler,
  compatibility=New_Purpose_Type
]

### Nouvelle Destination du Pipeline

HANDLER_LOCATION [
  placement="Juste après le bloc detect_emergence existant",
  step="STEP 3d (enregistrement/mise à jour)",
  reuses=["sig_check déjà calculé en STEP 2a (pas de double vérification)"]
]

### Champs Requis

AGENT_REGISTER_PAYLOAD [
  INTENT_PAYLOAD=[
    "purpose=agent_register",
    "sender=<agent_name>",
    "receiver=Server",
    "name=<new_or_existing_agent_name>",
    "public_key=<hex_64_chars>",
    "capabilities=<semicolon_separated_list>",
    "trust_score=<optional_float, default_0.5>"
  ],
  META=[
    "public_key=<hex_64_chars>"
  ],
  signature=["INTENT_PAYLOAD.signature=<hex_128_chars> (auto-signature de la nouvelle clé)"]
]

CAPABILITIES_SEPARATOR [
  format="semicolon (;) NOT comma",
  reason="Éviter l'auto-quoting du SDK et les ambiguïtés de parsing"
]

### Bootstrap et Limites v1

BOOTSTRAP_CONSTRAINT [
  scenario="Première inscription : signature ne peut PAS être vérifiée contre une entrée pré-existante",
  proof="Possession de la clé privée (auto-signature valide)",
  NOT_proof="Identité établie (pas de PKI/CA, modèle mono-opérateur cohérent)"
]

KEY_ROTATION_V1_LIMIT [
  constraint="Pas de vérification d'autorisation de rotation contre l'ANCIENNE clé",
  scope="Limite v1 explicite (même style que restricted_council)",
  future="v2 nécessitera une signature de rotation avec l'ancienne clé"
]

ROTATION_SIGNATURE_AVAILABLE [
  field="INTENT_PAYLOAD.rotation_signature=<hex_128_chars>",
  purpose="Preuve simultanée de possession des deux clés (ancienne ET nouvelle)",
  implementation="check_rotation_signature() disponible, optionnel en v1",
  prevents="Vol d'identité par reenregistrement avec nouveau keypair"
]

### Réponses du Serveur

AGENT_REGISTER_ACK [
  response_when="Signature valide, données complètes",
  purpose="agent_register_ack",
  content="name=<agent_name>",
  log_example="[Handler] agent_register: 'NewAgent' registered/updated (trust_score=0.5)"
]

AGENT_REGISTER_REJECTED [
  rejection_reasons=[
    "missing_name_or_public_key → Champ obligatoire absent",
    "signature_invalid → Signature ne correspond pas à la clé publique",
    "self_signature_required → Pas de signature fournie (bootstrap exige auto-signature)"
  ],
  purpose="agent_register_rejected",
  reason_field="Raison de rejet",
  detail_field="Détail technique si applicable"
]

### Tests et Vérification

AGENT_REGISTER_VERIFICATION [
  scenario1="payload non signé d'un expéditeur non enregistré → accepté (backward compat)",
  scenario2="agent_register avec vraie paire de clés + auto-signature valide → agent_register_ack",
  scenario3="agent_register sans signature → rejeté",
  scenario4="payload non signé d'un expéditeur maintenant enregistré → rejeté (missing_signature_for_registered_agent)",
  scenario5="même payload correctement signé → flux normal (communiqué avec capability routing)",
  scenario6="signature corrompue → signature_rejected (verification_failed)"
]

