+    // ── find_message_end (fix reassemblage TCP, audit multi-angle 2026-09-03) ──
+
+    #[test]
+    fn test_find_message_end_none_when_marker_absent() {
+        assert_eq!(find_message_end(b"#!CSTL v5.0.0 MODE=A\nMETA [x=y]"), None);
+    }
