+    println!();
+    if failures.is_empty() {
+        println!("✅ Tous les scenarios de gouvernance sont conformes.");
+    } else {
+        println!("❌ {} echec(s):", failures.len());
+        for f in &failures {
+            println!("   - {}", f);
+        }
+        std::process::exit(1);
+    }
