+# signature de messages par agent (Couche 2/securite, 2026-09-04), ferme
+# OWASP ASI03/ASI07 (identite/integrite inter-agents non authentifiees).
+# Feature "rand_core" necessaire pour SigningKey::generate(&mut csprng)
+# utilise dans les tests de src/signing.rs -- pas activee par defaut.
+version = "2"
+features = ["rand_core"]
+
+[dependencies.hex]
+# Le hex hand-roule via `{:x}` (server/audit.rs) marche seulement sur le
+# GenericArray retourne par sha2 -- pas sur les octets bruts [u8;N] des
+# cles/signatures Ed25519. Petite dependance dediee plutot que refaire un
+# encodeur hex a la main.
+version = "0.4"
