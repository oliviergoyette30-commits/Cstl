+    crate::execution_lab::CHAINABLE_PREDICATES
+        .iter()
+        .any(|predicate| predicate_to_property(predicate) == Some(property_id))
 }
 
 #[derive(Debug, Serialize)]
@@ -351,4 +364,32 @@ mod tests {
         assert!(is_chainable("P361"));
