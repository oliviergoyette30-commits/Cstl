+<body>
+<header>
+  <h1>CSTL Dashboard</h1>
+  <p>Hub local pour l'OS CSTL agentic kernel -- rafraichissement manuel, rien n'est simule.</p>
+</header>
+<main>
+
+  <section class="panel">
+    <h2><span class="title"><span class="dot" id="status-dot"></span> Serveur CSTL (TCP 5050)</span>
+      <button onclick="refreshStatus()">Rafraichir</button></h2>
