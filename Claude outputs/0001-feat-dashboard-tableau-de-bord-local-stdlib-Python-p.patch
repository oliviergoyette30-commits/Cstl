+<script>
+function addRelationRow(subject, predicate, object) {
+  const div = document.createElement('div');
+  div.className = 'rel-row';
+  div.innerHTML = `
+    <input placeholder="subject" value="${subject||''}">
+    <input placeholder="predicate (type)" value="${predicate||''}">
+    <input placeholder="object" value="${object||''}">
+    <button class="secondary" onclick="this.parentElement.remove()">x</button>`;
+  document.getElementById('relations').appendChild(div);
+}
+addRelationRow('paris', 'part_of', 'france');
+
+async function refreshStatus() {
+  const dot = document.getElementById('status-dot');
+  const body = document.getElementById('status-body');
+  body.textContent = 'Verification en cours...';
+  try {
+    const r = await fetch('/api/status');
+    const j = await r.json();
+    dot.className = 'dot ' + (j.up ? 'up' : 'down');
+    if (j.up) {
+      body.innerHTML = `<strong>UP</strong> -- connexion TCP reussie vers ${j.host}:${j.port} (${j.latency_ms} ms)`;
+    } else {
+      body.innerHTML = `<strong>DOWN</strong> -- connexion TCP echouee vers ${j.host}:${j.port}<br><span class="muted">${j.error}</span>`;
+    }
+    body.innerHTML += `<div class="timestamp">verifie a ${new Date(j.checked_at*1000).toLocaleTimeString()}</div>`;
+  } catch (e) {
+    dot.className = 'dot down';
+    body.textContent = 'Erreur cote dashboard: ' + e;
+  }
+}
+
+async function refreshAdn() {
+  const body = document.getElementById('adn-body');
+  body.textContent = 'Lecture SQLite en cours...';
+  try {
+    const r = await fetch('/api/adn');
+    const j = await r.json();
+    if (!j.ok) {
+      body.innerHTML = `<span style="color:var(--down)">Lecture impossible</span> (${j.reason||'?'}) -- ${j.detail||j.path||''}`;
+      return;
+    }
+    let html = `<div class="stat-row">
+      <div class="stat"><div class="n">${j.stats.total}</div><div class="l">entrees adn_store</div></div>
+      <div class="stat"><div class="n">${j.stats.committed}</div><div class="l">committed</div></div>
+      <div class="stat"><div class="n">${j.stats.pending}</div><div class="l">pending</div></div>
+      <div class="stat"><div class="n">${j.audit_count}</div><div class="l">audit_trail</div></div>
+    </div>`;
+    html += '<p class="muted">Dernieres entrees adn_store (max 20) :</p>';
+    if (j.recent_entries.length === 0) {
+      html += '<p class="muted">(vide -- aucun payload encore stocke dans ' + j.path + ')</p>';
+    } else {
+      html += '<table><thead><tr><th>hash</th><th>sigma</th><th>committed</th><th>produced_by</th><th>created_at</th></tr></thead><tbody>';
+      for (const e of j.recent_entries) {
+        html += `<tr><td>${(e.hash||'').slice(0,24)}...</td><td>${e.sigma}</td><td>${e.committed}</td><td>${e.produced_by||''}</td><td>${new Date(e.created_at*1000).toLocaleString()}</td></tr>`;
+      }
+      html += '</tbody></table>';
+    }
+    if (j.governance_events === null) {
+      html += '<p class="muted">table governance_events absente de ce fichier SQLite.</p>';
+    } else if (j.governance_events.length) {
+      html += '<p class="muted">Derniers evenements de gouvernance :</p><table><thead><tr><th>sender</th><th>ts</th><th>inconsistency</th><th>semantic_warning</th></tr></thead><tbody>';
+      for (const e of j.governance_events) {
+        html += `<tr><td>${e.sender}</td><td>${new Date(e.ts*1000).toLocaleString()}</td><td>${e.inconsistency}</td><td>${e.semantic_warning}</td></tr>`;
+      }
+      html += '</tbody></table>';
+    } else {
+      html += '<p class="muted">aucun evenement de gouvernance enregistre.</p>';
+    }
+    body.innerHTML = html;
+  } catch (e) {
+    body.textContent = 'Erreur cote dashboard: ' + e;
+  }
+}
+
+async function sendPayload() {
+  const purpose = document.getElementById('f-purpose').value;
+  const sender = document.getElementById('f-sender').value;
+  const receiver = document.getElementById('f-receiver').value;
+  const relations = [...document.querySelectorAll('#relations .rel-row')].map(row => {
+    const [s,p,o] = row.querySelectorAll('input');
+    return {subject: s.value, predicate: p.value, object: o.value};
+  });
+  document.getElementById('response-raw').textContent = 'Envoi en cours...';
+  try {
+    const r = await fetch('/api/send', {
+      method: 'POST', headers: {'Content-Type':'application/json'},
+      body: JSON.stringify({purpose, sender, receiver, relations})
+    });
+    const j = await r.json();
+    document.getElementById('payload-preview').textContent = j.sent || '(non genere)';
+    if (j.ok) {
+      document.getElementById('response-raw').textContent = j.raw_response || '(reponse vide)';
+      document.getElementById('send-meta').textContent =
+        `round-trip reel: ${j.round_trip_ms} ms, ${j.bytes_received} octets recus`;
+    } else {
+      document.getElementById('response-raw').textContent = '(echec de connexion)';
+      document.getElementById('send-meta').textContent = `Erreur: ${j.error} (apres ${j.round_trip_ms} ms)`;
+    }
+  } catch (e) {
+    document.getElementById('response-raw').textContent = 'Erreur cote dashboard: ' + e;
+  }
+}
+
+async function refreshOther() {
+  const tbody = document.querySelector('#other-table tbody');
+  tbody.innerHTML = '<tr><td colspan="3" class="muted">Verification...</td></tr>';
+  try {
+    const r = await fetch('/api/other-systems');
+    const list = await r.json();
+    const badgeClass = (status) => {
+      if (status === 'cable_cote_serveur_pas_visible_ici') return 'wired';
+      if (status === 'non_integre') return 'none';
+      if (status === 'dossier_present') return 'present';
+      if (status === 'dossier_absent') return 'none';
+      return 'neutral';
+    };
+    tbody.innerHTML = list.map(s =>
+      `<tr><td>${s.name}</td><td><span class="badge ${badgeClass(s.status)}">${s.status}</span></td><td class="muted">${s.detail}</td></tr>`
+    ).join('');
+  } catch (e) {
+    tbody.innerHTML = `<tr><td colspan="3" class="muted">Erreur: ${e}</td></tr>`;
+  }
+}
+
+// Un seul chargement automatique a l'ouverture de la page -- ensuite,
+// tout rafraichissement est manuel (bouton), comme demande.
+refreshStatus();
+refreshAdn();
+refreshOther();
+</script>
+</body>
+</html>
