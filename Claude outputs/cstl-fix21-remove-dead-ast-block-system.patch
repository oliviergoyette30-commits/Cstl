-// ── Structures partagées avec le parser ─────────────────────────────────────
-// PHASE 2 : on utilise directement les structs du parser (crate::ast) pour que
-// validate_semantics puisse être appelé sur doc.blocks sans conflit de type.
-use crate::ast::Block;
