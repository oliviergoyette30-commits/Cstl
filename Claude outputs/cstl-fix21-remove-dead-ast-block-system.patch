-fn is_canonical_order(names: &[&str], order: &[&str]) -> bool {
-    let mut last = 0usize;
-    for n in names {
-        if let Some(idx) = order.iter().position(|o| n.starts_with(o)) {
-            if idx < last { return false; }
-            last = idx;
-        }
-    }
-    true
-}
