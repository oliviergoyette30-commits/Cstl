From d344c280a78c1a639057dd0f0cbe02512539a57b Mon Sep 17 00:00:00 2001
From: cloud-sandbox <cloud-sandbox@local>
Date: Thu, 3 Sep 2026 14:08:39 +0000
Subject: [PATCH] fix(security): brancher security_scan() sur le chemin reseau
 reel

Trouvaille critique de l'audit multi-angle (2026-09-03): security.rs
(anti-injection zero-width/bidi/homoglyphe/META imbrique, Sessions #6+#7)
existait depuis sa creation sans etre appele nulle part -- handler.rs
importait 11 modules mais jamais crate::security. Le serveur TCP reel ne
filtrait donc aucun payload entrant par cette couche.

Ajoute STEP 0 dans handle_connection: security::security_scan(&raw_payload)
avant tout parsing. Erreurs (META imbrique / profondeur excessive) ->
rejet immediat (purpose=security_rejected), payload jamais transmis au
parser. Avertissements (zero-width/bidi stripped, homoglyphe dans une
position mot-cle) -> logges cote serveur, payload nettoye (cleaned)
transmis au parser normalement.

Trouvaille secondaire de l'audit, PAS corrigee ici (hors scope, plus
grande qu'annoncee): src/tests.rs (796 lignes, tests SEC_Q1-Q5 inclus)
n'est effectivement jamais execute (aucun "mod tests;" dans lib.rs), mais
en creusant je trouve que c'est plus profond qu'un simple mod manquant --
tests.rs et src/ast.rs (CstlDocument/Block/Relation) forment ensemble
toute une implementation parallele de parser jamais reliee au vrai
pipeline (server/parser.rs, avec des types completement differents:
HashMap<String,String> au lieu de CstlDocument). tests.rs appelle
crate::parse(), une fonction qui n'existe nulle part dans le crate --
donc meme ajouter "mod tests;" ne compilerait pas sans d'abord ecrire ce
parser manquant. C'est un chantier separe, pas un simple oubli de
declaration de module. Signale ici pour ne pas le laisser dans l'angle
mort, pas traite.

Verifie: cargo build clean, 112 tests passent, ET test fumee TCP reel en
direct sur 3 cas -- payload propre (traite normalement), injection META
imbriquee (rejetee avant parsing, purpose=security_rejected), caractere
zero-width U+200B (nettoye silencieusement, payload traite normalement
apres nettoyage).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018JMwGsM76zmiqW9BtVgcgH
---
 src/server/handler.rs | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/src/server/handler.rs b/src/server/handler.rs
index 66b6e58..0c81dee 100644
--- a/src/server/handler.rs
+++ b/src/server/handler.rs
@@ -20,6 +20,7 @@ use crate::restricted_council::RestrictedCouncil;
 use crate::telegram_council::TelegramNotifier;
 use crate::obsidian_escalation::ObsidianEscalation;
 use crate::emergence;
+use crate::security;
 use super::audit::HashChain;
 use super::parser;
 use super::validator;
@@ -46,7 +47,32 @@ pub async fn handle_connection(
         
         let raw_payload = String::from_utf8_lossy(&buffer[..n]).to_string();
         eprintln!("[Handler] Received {} bytes", n);
-        
+
+        // STEP 0: Security scan (Sessions #6+#7) -- trouve dans un audit multi-angle
+        // (2026-09-03) que security::security_scan existait depuis sa creation sans
+        // etre appele nulle part sur le chemin reseau reel. Corrige ici: on nettoie
+        // les codepoints dangereux (zero-width/bidi/C1) AVANT le parsing, et on
+        // rejette purement et simplement tout payload avec une erreur de securite
+        // (META imbrique / injection, profondeur de crochets excessive) sans meme
+        // tenter de le parser.
+        let security_report = security::security_scan(&raw_payload);
+        if !security_report.warnings.is_empty() {
+            eprintln!("[Handler] 🛡️  Security warnings: {:?}", security_report.warnings);
+        }
+        if !security_report.errors.is_empty() {
+            eprintln!("[Handler] 🚫 Security scan rejected payload: {:?}", security_report.errors);
+            let rejection = format!(
+                "#!CSTL v5.0.0 MODE=A\n\
+                META [encoder=CstlNativeServer, produced_by=Server, status=error]\n\
+                INTENT_PAYLOAD [purpose=security_rejected, details={}]\n\
+                ---END---\n",
+                security_report.errors.join("; ").replace("\"", "\\\"")
+            );
+            socket.write_all(rejection.as_bytes()).await?;
+            continue;
+        }
+        let raw_payload = security_report.cleaned;
+
         // STEP 1: Parse CSTL payload
         let parse_result = parser::parse_payload(&raw_payload);
         
