+async function refreshTelegramObsidian() {
+  const body = document.getElementById('telegram-obsidian-body');
+  body.textContent = 'Lecture de l\'ADN store (preuve indirecte) en cours...';
+  try {
+    const r = await fetch('/api/telegram-obsidian-status');
+    const j = await r.json();
+    const fmtEvidence = (e) => {
+      if (e.evidence === 'aucune_escalade_dans_historique' || e.evidence === 'aucune_inconsistance_dans_historique') {
+        return `<span class="badge neutral">aucune escalade dans l'historique</span> ${e.detail}`;
+      }
+      if (e.evidence === 'base_absente' || e.evidence === 'lecture_impossible' || e.evidence === 'requete_echouee') {
+        return `<span class="badge none">verification impossible</span> ${e.detail}`;
+      }
+      return `<span class="badge wired">escalade detectee (preuve indirecte)</span> ${e.detail}`;
+    };
+    let html = `<p class="muted" style="border:1px solid var(--border); border-radius:6px; padding:8px;">${j.limite_architecturale}</p>`;
+    html += `<p class="muted">Vu par CE process dashboard (pas le serveur Rust) : TELEGRAM_BOT_TOKEN=${j.dashboard_process_env.TELEGRAM_BOT_TOKEN}, TELEGRAM_CHAT_ID=${j.dashboard_process_env.TELEGRAM_CHAT_ID}, OBSIDIAN_VAULT_PATH=${j.dashboard_process_env.OBSIDIAN_VAULT_PATH}</p>`;
+    html += `<p><strong>Telegram</strong>: ${fmtEvidence(j.telegram)}</p>`;
+    if (j.telegram.priority_critical_payloads_recents && j.telegram.priority_critical_payloads_recents.length) {
+      html += '<table><thead><tr><th>hash (priority=critical)</th><th>created_at</th></tr></thead><tbody>';
+      for (const e of j.telegram.priority_critical_payloads_recents) {
+        html += `<tr><td>${(e.hash||'').slice(0,24)}...</td><td>${new Date(e.created_at*1000).toLocaleString()}</td></tr>`;
+      }
+      html += '</tbody></table>';
+    }
+    if (j.telegram.governance_alerts_recents && j.telegram.governance_alerts_recents.length) {
+      html += '<table><thead><tr><th>governance_alerts.sender</th><th>last_alert_ts</th></tr></thead><tbody>';
+      for (const e of j.telegram.governance_alerts_recents) {
+        html += `<tr><td>${e.sender}</td><td>${new Date(e.last_alert_ts*1000).toLocaleString()}</td></tr>`;
+      }
+      html += '</tbody></table>';
+    }
+    html += `<p><strong>Obsidian</strong>: ${fmtEvidence(j.obsidian)}</p>`;
+    if (j.obsidian.governance_events_inconsistency_recents && j.obsidian.governance_events_inconsistency_recents.length) {
+      html += '<table><thead><tr><th>governance_events.sender</th><th>ts</th></tr></thead><tbody>';
+      for (const e of j.obsidian.governance_events_inconsistency_recents) {
+        html += `<tr><td>${e.sender}</td><td>${new Date(e.ts*1000).toLocaleString()}</td></tr>`;
+      }
+      html += '</tbody></table>';
+    }
+    body.innerHTML = html;
+  } catch (e) {
+    body.textContent = 'Erreur cote dashboard: ' + e;
+  }
+}
+
+// === ORCHESTRATEUR ===
+async function lancerRelais() {
+  const turns = document.getElementById('orch-turns').value;
+  const topic = document.getElementById('orch-topic').value;
+  const status = document.getElementById('orch-status');
+  const traceDiv = document.getElementById('orch-trace');
+  status.textContent = `Lancement d'un relais reel de ${turns} tour(s) contre le serveur CSTL...`;
+  traceDiv.innerHTML = '';
+  try {
+    const r = await fetch('/api/orchestrate', {
+      method: 'POST', headers: {'Content-Type':'application/json'},
+      body: JSON.stringify({turns: parseInt(turns, 10), topic})
+    });
+    const j = await r.json();
+    if (!j.ok) {
+      status.innerHTML = `<span style="color:var(--down)">${j.error}</span>`;
+      if (j.trace && j.trace.length) {
+        traceDiv.innerHTML = '<p class="muted">Trace partielle avant echec :</p><pre>' + JSON.stringify(j.trace, null, 2) + '</pre>';
+      }
+      return;
+    }
+    status.innerHTML = `<span style="color:var(--ok)">${j.turns_completed} tour(s) reellement effectue(s)</span> -- brain=${j.brain}${j.model ? ' ('+j.model+')' : ''}${j.real_brain ? '' : ' (BRAIN INJECTE POUR TEST -- pas un vrai modele)'}`;
+    traceDiv.innerHTML = '<p class="muted">Trace complete (payload envoye + reponse recue a chaque tour) :</p><pre>' + JSON.stringify(j.trace, null, 2) + '</pre>';
+  } catch (e) {
+    status.textContent = 'Erreur cote dashboard: ' + e;
+  }
+}
+
