 /// Produce the normative canonical text form of a CSTL payload.
 pub fn canonical_form(text: &str) -> String {
+    // Trouvaille de l'audit multi-angle (2026-09-03): la regle "NFC" ratifiee et
+    // annoncee ligne 2 ci-dessus n'etait jamais appliquee -- deux representations
+    // Unicode canoniquement equivalentes du meme texte (ex: "e" precompose vs
+    // "e" + accent combinant) produisaient deux canonical_hash differents, cassant
+    // l'invariant "meme contenu -> meme hash". Corrige en normalisant en NFC
+    // AVANT toute autre etape.
+    use unicode_normalization::UnicodeNormalization;
+    let text: String = text.nfc().collect();
+
     let mut lines: Vec<String> = text
         .replace("\r\n", "\n")
         .replace("\r", "\n")
@@ -186,3 +195,31 @@ fn sha256(data: &[u8]) -> [u8; 32] {
 fn hex(bytes: &[u8]) -> String {
     bytes.iter().map(|b| format!("{:02x}", b)).collect()
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_nfc_composed_and_decomposed_produce_same_hash() {
+        // Cas exact de l'audit multi-angle (2026-09-03): "cafe" avec e-aigu
+        // precompose (U+00E9) vs "cafe" avec e + accent aigu combinant
+        // (U+0065 U+0301) -- meme rendu visuel, meme contenu semantique.
+        let composed = "META [name=caf\u{00e9}]";
+        let decomposed = "META [name=cafe\u{0301}]";
+        assert_ne!(composed, decomposed, "les deux representations doivent bien differer en octets bruts");
+        assert_eq!(
+            canonical_hash(composed),
+            canonical_hash(decomposed),
+            "meme contenu semantique -> meme hash canonique, meme si l'encodage Unicode differe"
+        );
+    }
+
+    #[test]
+    fn test_nfc_normalization_applied_to_canonical_form() {
+        let decomposed = "META [name=cafe\u{0301}]";
+        let form = canonical_form(decomposed);
+        assert!(form.contains('\u{00e9}'), "canonical_form doit produire la forme composee (NFC)");
+        assert!(!form.contains('\u{0301}'), "l'accent combinant ne doit plus apparaitre separement apres NFC");
+    }
+}
