+    #[test]
+    fn test_audit_persist_and_load() {
+        let store = AdnStore::open(":memory:").unwrap();
+        let entry = AuditEntry {
+            hash: "sha256:abc123".to_string(),
+            parent_hash: "root".to_string(),
+            sender: "alice".to_string(),
+            receiver: "bob".to_string(),
