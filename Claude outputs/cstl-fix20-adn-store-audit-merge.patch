+        store.save_audit_entry(&entry).unwrap();
+        assert_eq!(store.audit_count().unwrap(), 1);
+        let chain = store.load_chain().unwrap();
+        assert_eq!(chain.len(), 1);
+        assert_eq!(chain.entries[0].hash, "sha256:abc123");
