+/// Extrait la "decision" d'un payload CSTL brut. Port des deux styles que
+/// reconnaissait la version Python: "DECISION: <valeur>" jusqu'a la fin de
+/// ligne ou un `[`, ou un bloc "DECISION [ ... ]".
+///
+/// Correction d'une trouvaille majeure de l'audit multi-angle (2026-09-03):
+/// le style bloc tronquait a 80 caracteres AVANT toute comparaison
+/// (`.chars().take(80)`), et `decisions_differ()` comparait ensuite les
+/// valeurs DEJA tronquees. Deux decisions reellement differentes partageant
+/// un prefixe >=80 caracteres (frequent quand le format inclut une
+/// justification avant la valeur finale) etaient jugees identiques -- une
+/// vraie revision de position pouvait ne jamais generer d'emergence_proof.
+/// Reproduit par l'audit: prefix="X"*80, solo="DECISION [" + prefix + "AAAA]",
+/// trio="DECISION [" + prefix + "BBBB]" -> extract_decision identique pour
+/// les deux, revised=false a tort. La troncature n'existait dans le Python
+/// original que pour l'AFFICHAGE, pas pour la comparaison -- ce port la
+/// laissait affecter les deux usages a la fois. Supprimee: le texte complet
+/// est desormais compare et stocke (le champ SQLite est TEXT, non borne).
 fn extract_decision(payload: &str) -> Option<String> {
     if let Some(idx) = payload.find("DECISION:") {
         let rest = &payload[idx + "DECISION:".len()..];
@@ -49,7 +62,7 @@ fn extract_decision(payload: &str) -> Option<String> {
         let rest = payload[idx + "DECISION".len()..].trim_start();
         if let Some(rest) = rest.strip_prefix('[') {
             if let Some(end) = rest.find(']') {
-                let value: String = rest[..end].trim().chars().take(80).collect();
+                let value = rest[..end].trim().to_string();
                 if !value.is_empty() {
                     return Some(value);
                 }
@@ -172,6 +185,20 @@ mod tests {
         assert_eq!(extract_decision("META [x=y]\n---END---"), None);
     }
 
+    #[test]
+    fn test_extract_decision_block_style_not_truncated_past_80_chars() {
+        // Cas exact de l'audit multi-angle (2026-09-03): deux decisions dont
+        // les 80 premiers caracteres sont identiques mais qui divergent apres
+        // ne doivent plus etre confondues.
+        let prefix = "X".repeat(80);
+        let solo_payload = format!("DECISION [{prefix}AAAA]");
+        let trio_payload = format!("DECISION [{prefix}BBBB]");
+        let solo = extract_decision(&solo_payload).unwrap();
+        let trio = extract_decision(&trio_payload).unwrap();
+        assert_ne!(solo, trio, "les deux decisions doivent rester distinguables au-dela de 80 caracteres");
+        assert!(decisions_differ(&solo, &trio));
+    }
+
     #[test]
     fn test_parse_solo_hashes_roundtrip() {
         let parsed = parse_solo_hashes("Agent_CLAUDE:sha256:abc123;Agent_GPT:sha256:def456");
@@ -208,6 +235,27 @@ mod tests {
         assert_eq!(proofs[0].position_changed_by.as_deref(), Some("Agent_CLAUDE"));
     }
 
+    #[test]
+    fn test_detect_revisions_catches_a_change_hidden_past_80_chars() {
+        // Cas de l'audit, bout en bout via detect_revisions() (la fonction
+        // reellement appelee en production), pas seulement extract_decision.
+        let store = AdnStore::open(":memory:").unwrap();
+        let prefix = "X".repeat(80);
+        store.put("solo_a", &format!("DECISION [{prefix}AAAA]"), None, None, 0.80, None, None, None).unwrap();
+        store.put("trio_a", &format!("DECISION [{prefix}BBBB]"), None, None, 0.90, None, None, None).unwrap();
+
+        let mut solo_hashes = HashMap::new();
+        solo_hashes.insert("Agent_X".to_string(), "solo_a".to_string());
+
+        let reports = detect_revisions(&store, "trio_a", &solo_hashes, "Q1").unwrap();
+        assert_eq!(reports.len(), 1);
+        assert!(reports[0].revised, "une vraie revision de position (AAAA->BBBB) doit etre detectee malgre le prefixe commun de 80 caracteres");
+        assert!(reports[0].proof_id.is_some());
+
+        let proofs = store.get_emergence_proofs().unwrap();
+        assert_eq!(proofs.len(), 1);
+    }
+
