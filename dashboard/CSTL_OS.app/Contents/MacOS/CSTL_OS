#!/bin/bash
# CSTL_OS -- lanceur double-clic pour l'OS CSTL agentic kernel (2026-09-07).
#
# Ce script est l'executable d'une application macOS minimale (un simple
# bundle .app -- Info.plist + ce script, pas d'app Swift/Electron compilee).
# Double-cliquer CSTL_OS.app dans le Finder fait ceci, dans l'ordre :
#   1. localise le depot (voir REPO_ROOT ci-dessous -- CONTRAINTE : ce
#      fichier doit rester a l'interieur de <depot>/dashboard/CSTL_OS.app/,
#      sinon deplace REPO_ROOT en consequence)
#   2. demarre Ollama (port 11434) s'il n'est pas deja lance -- MEILLEUR
#      EFFORT, non bloquant : si ni la commande `ollama` ni /Applications/
#      Ollama.app ne sont trouves, ce pas est saute et note dans les logs,
#      le reste continue quand meme (Hermes est optionnel, pas un
#      prerequis dur du serveur CSTL lui-meme)
#   3. demarre le service OpenClaw (port 19001) s'il n'est pas deja lance,
#      via `openclaw daemon start` -- MEILLEUR EFFORT, non bloquant, meme
#      logique que Ollama : OpenClaw est un systeme externe optionnel, pas
#      un prerequis dur
#   4. demarre le serveur Rust CSTL (cargo run --release) s'il ne tourne
#      pas deja sur le port 5050
#   5. demarre le dashboard Python (dashboard/server.py) s'il ne tourne pas
#      deja sur le port 5099
#   6. ouvre http://127.0.0.1:5099/ dans le navigateur par defaut
#   7. affiche une notification macOS de statut (demarrage / pret / erreur)
#      puisqu'une .app lancee depuis le Finder n'a pas de terminal visible
#      pour afficher des logs -- les vraies sorties de tous les process
#      sont quand meme ecrites dans dashboard/logs/ pour diagnostic reel.
#
# Ce script ne construit AUCUN "kernel" au sens OS -- il orchestre juste le
# demarrage de deux process deja existants et verifies dans ce depot (le
# serveur Rust et le dashboard Python). Il n'arrete rien automatiquement :
# les deux process continuent de tourner apres la fermeture du navigateur ;
# utilise CSTL_OS_stop.command (a cote de ce .app) pour les arreter.

set -u

# --- PATH -------------------------------------------------------------------
# BUG TROUVE ET CORRIGE LE 07/09/2026 : une .app lancee depuis le Finder
# n'herite PAS de ~/.zshrc / ~/.bashrc (pas de shell de login), donc les
# commandes installees via npm global (ex: `openclaw`, qui vit dans
# ~/.npm-global/bin/ sur cette machine, confirme via le mount device_bash)
# sont introuvables ici meme si elles marchent dans un vrai Terminal. Constate
# en direct : "commande 'openclaw' introuvable dans PATH" au demarrage alors
# que `openclaw` fonctionne normalement en Terminal. Ajoute explicitement,
# sans ecraser le PATH deja present (Homebrew etc. restent prioritaires).
export PATH="$HOME/.npm-global/bin:$PATH"

# --- Localisation du depot : CSTL_OS.app/Contents/MacOS/CSTL_OS ------------
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
APP_MACOS_DIR="$(dirname "$SCRIPT_PATH")"
DASHBOARD_DIR="$(cd "$APP_MACOS_DIR/../../.." && pwd)"
REPO_ROOT="$(cd "$DASHBOARD_DIR/.." && pwd)"
LOG_DIR="$DASHBOARD_DIR/logs"
mkdir -p "$LOG_DIR"

RUST_LOG="$LOG_DIR/cstl_server.log"
DASHBOARD_LOG="$LOG_DIR/dashboard.log"
# NOTE (bug trouve et corrige le 2026-09-07) : ce script n'ecrit plus de
# fichier .pid pour l'arret -- un premier essai capturait `$!` sur le
# process `cargo run` lance en arriere-plan, mais ce PID est celui du
# wrapper cargo, pas du vrai binaire `cstl_parser` qu'il execute en
# ENFANT distinct. Tuer ce PID laissait le vrai serveur tourner, orphelin,
# invisible (confirme par `ps aux` apres un "arret" reussi en apparence).
# CSTL_OS_stop.command cherche desormais les vrais process par nom
# (pkill -f) plutot que par un PID capture au demarrage -- voir ce fichier.

# Le port du serveur Rust est cable en dur a 5050 dans src/main.rs (pas lu
# depuis une variable d'environnement) -- ne pas le rendre "configurable"
# ici serait mentir sur ce que le binaire fait reellement. Seul le port du
# dashboard (CSTL_DASHBOARD_PORT, lu par dashboard/server.py) est reellement
# configurable.
CSTL_SERVER_PORT=5050
CSTL_DASHBOARD_PORT="${CSTL_DASHBOARD_PORT:-5099}"

notify() {
    # Notification macOS native -- osascript est toujours present sur macOS,
    # absent ailleurs (ce script n'est de toute facon utile que sur macOS).
    local title="$1" message="$2"
    osascript -e "display notification \"$message\" with title \"$title\"" >/dev/null 2>&1 || true
}

port_is_open() {
    local port="$1"
    # nc (netcat) est preinstalle sur macOS -- verification TCP simple, pas
    # de dependance supplementaire a installer.
    nc -z -w1 127.0.0.1 "$port" >/dev/null 2>&1
}

wait_for_port() {
    local port="$1" label="$2" max_tries="${3:-60}"
    local tries=0
    while ! port_is_open "$port"; do
        tries=$((tries + 1))
        if [ "$tries" -ge "$max_tries" ]; then
            notify "CSTL OS" "Echec : $label n'a pas repondu sur le port $port apres ${max_tries}s. Voir $LOG_DIR"
            return 1
        fi
        sleep 1
    done
    return 0
}

notify "CSTL OS" "Demarrage en cours..."

# --- 0a. Ollama / Hermes local (port 11434) ---------------------------------
# Ajoute le 07/09/2026 a la demande de l'utilisateur ("automatiser
# l'ouverture d'Ollama/OpenClaw en meme temps que CSTL"). MEILLEUR EFFORT
# assume et documente : Ollama et OpenClaw sont des systemes EXTERNES au
# serveur CSTL, pas des dependances de src/ (voir dashboard/index.html,
# section "Autres systemes", qui le dit deja explicitement). Si l'un des
# deux est absent/mal installe, ce script ne doit PAS empecher le serveur
# CSTL et le dashboard de demarrer -- d'ou "|| true" et pas de `exit 1`
# ici, contrairement aux etapes 1 et 2 (Rust/dashboard) qui restent
# critiques.
OLLAMA_PORT=11434
OLLAMA_LOG="$LOG_DIR/ollama.log"
if port_is_open "$OLLAMA_PORT"; then
    echo "[$(date)] Port $OLLAMA_PORT deja occupe -- Ollama suppose deja lance." >> "$OLLAMA_LOG"
elif command -v ollama >/dev/null 2>&1; then
    echo "[$(date)] Lancement: ollama serve" >> "$OLLAMA_LOG"
    ( nohup ollama serve >> "$OLLAMA_LOG" 2>&1 & )
    wait_for_port "$OLLAMA_PORT" "Ollama" 30 || echo "[$(date)] Ollama pas pret apres 30s -- non bloquant, on continue." >> "$OLLAMA_LOG"
elif [ -d "/Applications/Ollama.app" ]; then
    echo "[$(date)] Lancement: open -a Ollama" >> "$OLLAMA_LOG"
    open -a Ollama >> "$OLLAMA_LOG" 2>&1 || true
    wait_for_port "$OLLAMA_PORT" "Ollama" 30 || echo "[$(date)] Ollama pas pret apres 30s -- non bloquant, on continue." >> "$OLLAMA_LOG"
else
    echo "[$(date)] Ollama introuvable (ni commande 'ollama' ni /Applications/Ollama.app) -- Hermes local indisponible, non bloquant." >> "$OLLAMA_LOG"
fi

# --- 0b. OpenClaw (gateway, port 19001) -------------------------------------
# Meme logique "meilleur effort" que ci-dessus. Utilise `openclaw daemon
# start` (deja un service gere par OpenClaw lui-meme, voir `openclaw daemon
# --help`) plutot que de lancer un process brut ici -- si le service n'a
# jamais ete installe (`openclaw daemon install`), `start` peut echouer ;
# c'est attrape et journalise, jamais fatal pour CSTL_OS.
OPENCLAW_PORT=19001
OPENCLAW_LOG="$LOG_DIR/openclaw.log"
if port_is_open "$OPENCLAW_PORT"; then
    echo "[$(date)] Port $OPENCLAW_PORT deja occupe -- OpenClaw suppose deja lance." >> "$OPENCLAW_LOG"
elif command -v openclaw >/dev/null 2>&1; then
    echo "[$(date)] Lancement: openclaw daemon start" >> "$OPENCLAW_LOG"
    ( openclaw daemon start >> "$OPENCLAW_LOG" 2>&1 & )
    wait_for_port "$OPENCLAW_PORT" "OpenClaw" 30 || echo "[$(date)] OpenClaw pas pret apres 30s (peut-etre jamais installe: 'openclaw daemon install') -- non bloquant, on continue." >> "$OPENCLAW_LOG"
else
    echo "[$(date)] commande 'openclaw' introuvable dans PATH -- non demarre, non bloquant." >> "$OPENCLAW_LOG"
fi

# --- 1. Serveur Rust CSTL (port 5050) --------------------------------------
if port_is_open "$CSTL_SERVER_PORT"; then
    echo "[$(date)] Port $CSTL_SERVER_PORT deja occupe -- suppose deja lance, on ne redemarre pas." >> "$RUST_LOG"
else
    if ! command -v cargo >/dev/null 2>&1; then
        notify "CSTL OS" "Erreur : cargo introuvable. Installe Rust (rustup.rs) avant de relancer."
        exit 1
    fi
    echo "[$(date)] Lancement: cargo run --release (cwd=$REPO_ROOT)" >> "$RUST_LOG"
    ( cd "$REPO_ROOT" && nohup cargo run --release >> "$RUST_LOG" 2>&1 & )
    if ! wait_for_port "$CSTL_SERVER_PORT" "le serveur CSTL (cargo)" 90; then
        exit 1
    fi
fi

# --- 2. Dashboard Python (port 5099) ---------------------------------------
if port_is_open "$CSTL_DASHBOARD_PORT"; then
    echo "[$(date)] Port $CSTL_DASHBOARD_PORT deja occupe -- suppose deja lance, on ne redemarre pas." >> "$DASHBOARD_LOG"
else
    if ! command -v python3 >/dev/null 2>&1; then
        notify "CSTL OS" "Erreur : python3 introuvable."
        exit 1
    fi
    echo "[$(date)] Lancement: python3 dashboard/server.py (cwd=$REPO_ROOT)" >> "$DASHBOARD_LOG"
    ( cd "$REPO_ROOT" && nohup python3 dashboard/server.py >> "$DASHBOARD_LOG" 2>&1 & )
    if ! wait_for_port "$CSTL_DASHBOARD_PORT" "le dashboard Python" 20; then
        exit 1
    fi
fi

# --- 3. Ouvrir le navigateur -------------------------------------------------
open "http://127.0.0.1:${CSTL_DASHBOARD_PORT}/"
notify "CSTL OS" "Pret -- http://127.0.0.1:${CSTL_DASHBOARD_PORT}/"
