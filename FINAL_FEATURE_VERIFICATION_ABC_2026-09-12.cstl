# ============================================================================

FEATURE_STATUS [feature=A_signatures, status=COMPLETE_VERIFIED, implementation=src/signing.rs]
FEATURE_DETAIL [description=Signature Ed25519 sur payloads CSTL avec verification cryptographique]
FEATURE_DETAIL [dependencies=ed25519_dalek v2, hex 0.4]
FEATURE_DETAIL [wire_format_new=META.public_key (64 hex chars = 32 bytes)]
FEATURE_DETAIL [wire_format_new=INTENT_PAYLOAD.signature (128 hex chars = 64 bytes)]
FEATURE_DETAIL [wire_format_new=INTENT_PAYLOAD.rotation_signature (for key rotation proof)]

MODULE_FUNCTION [name=check_signature, returns=SignatureCheck enum]
MODULE_FUNCTION [name=check_rotation_signature, returns=SignatureCheck enum]
MODULE_FUNCTION [name=verify_raw (internal), shared verification logic]

ENUM_VARIANT [enum=SignatureCheck, value=NotPresent, meaning=ni public_key ni signature presents]
ENUM_VARIANT [enum=SignatureCheck, value=Valid, meaning=signature cryptographically valid]
ENUM_VARIANT [enum=SignatureCheck, value=Invalid(reason), meaning=failed with specific reason]

INVALID_REASONS [reason=invalid_hex, reason=bad_public_key_length, reason=bad_signature_length, reason=verification_failed, reason=incomplete_signature_fields]

POLICY [description=Signature optionnelle globalement - obligatoire seulement si sender deja enregistre avec public_key]
POLICY [mechanism=handler.rs STEP 2a: check_signature puis comparaison registre]
POLICY [backward_compatibility=Non-signed messages from unknown senders toujours acceptes]
POLICY [regression_protection=148 existing tests + 6 new compression tests all PASS]

CRYPTOGRAPHY_CANON [format=VERSION|v VERSION, MODE|M, META|k=v|k=v... INTENT|k=v|k=v... RELATIONS|...]
CRYPTOGRAPHY_CANON [normalization=NFC unicode + BTreeMap sort sur cles]
CRYPTOGRAPHY_CANON [exclusions=META.PARENT_HASH (circular), INTENT.signature, INTENT.rotation_signature]
CRYPTOGRAPHY_CANON [inclusions=META.public_key (tie signature to claimed key)]

