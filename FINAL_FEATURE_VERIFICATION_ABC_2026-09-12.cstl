# ============================================================================
# FEATURE B-2: agent_register avec rotation_signature protection
# ============================================================================

FEATURE_STATUS [feature=B2_agent_register, status=COMPLETE_VERIFIED, implementation=src/server/handler.rs lines 461-535]
FEATURE_DETAIL [description=Enregistrement dynamique d'agents avec protection contre vol identite]
FEATURE_DETAIL [purpose_value=agent_register, mechanism=short-circuit bloc apres STEP 2a]
FEATURE_DETAIL [bootstrap_model=Signature prouve possession cle privee, pas identite pre-existante]
FEATURE_DETAIL [pki_model=Aucune PKI/CA - mono-operator trust model (RestrictedCouncil)]

IDENTITY_THEFT_PROTECTION [mechanism=rotation_signature required for key change on existing name]
IDENTITY_THEFT_PROTECTION [scenario=Agent charlie DEJA enregistre avec cle publique X]
IDENTITY_THEFT_PROTECTION [scenario_evil=Attacker soumet agent_register charlie avec cle Y (sa propre cle)]
IDENTITY_THEFT_PROTECTION [defense=Handler demande rotation_signature signi avec l'ANCIENNE cle X]
IDENTITY_THEFT_PROTECTION [outcome=Attacker ne peut pas signer avec X (ne possede pas cle privee) - REJECTED]

REGISTER_FIELDS [field=name, required=yes, type=string]
REGISTER_FIELDS [field=public_key, required=yes, type=hex 64 chars]
REGISTER_FIELDS [field=capabilities, required=yes, type=string semicolon-separated]
REGISTER_FIELDS [field=trust_score, required=no, default=0.5]
REGISTER_FIELDS [field=signature, required=yes, type=hex 128 chars, mechanism=auto-signature]
REGISTER_FIELDS [field=rotation_signature, required=conditional, type=hex 128 chars if key rotation]

REGISTER_POLICY [first_registration_bootstrap=name unknown, cle publique+signature prouvent possession]
REGISTER_POLICY [re_register_same_key=name known, meme cle, just refresh capabilities/trust_score]
REGISTER_POLICY [re_register_new_key=name known, NOUVELLE cle - rotation_signature OBLIGATOIRE]

RESPONSE_SUCCESS [purpose=agent_register_ack, fields=name]
RESPONSE_REJECT [purpose=agent_register_rejected, reasons=missing_name_or_public_key]
RESPONSE_REJECT [purpose=agent_register_rejected, reasons=signature_invalid]
RESPONSE_REJECT [purpose=agent_register_rejected, reasons=self_signature_required]
RESPONSE_REJECT [purpose=agent_register_rejected, reasons=rotation_proof_required]
RESPONSE_REJECT [purpose=agent_register_rejected, reasons=rotation_proof_invalid]

HANDLER_FLOW [step=1_parse_and_validate, normal_flow=yes]
HANDLER_FLOW [step=2_security_scan, normal_flow=yes]
HANDLER_FLOW [step=2a_signature_verification, normal_flow=yes]
