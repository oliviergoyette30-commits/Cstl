# ============================================================================
# INTEGRATION VERIFICATION: All Four Features Together
# ============================================================================

INTEGRATION_SCENARIO [name=Full Lifecycle Agent Registration with Signature]
INTEGRATION_STEP [step=1, description=Python agent generates keypair via load_or_create_keypair]
INTEGRATION_STEP [step=2, description=Python agent constructs agent_register payload with name/public_key/capabilities]
INTEGRATION_STEP [step=3, description=Python agent signs via cstl_signing_bytes (Rust-compatible format)]
INTEGRATION_STEP [step=4, description=Python agent sends socket message to Rust server on TCP 5050]
INTEGRATION_STEP [step=5, description=Rust handler receives, parses, validates (STEP 0-2 security/format)]
INTEGRATION_STEP [step=6, description=Rust handler STEP 2a: calls signing::check_signature]
INTEGRATION_STEP [step=7, description=Signature verification: ed25519_dalek verifies Python signature against public_key]
INTEGRATION_STEP [step=8, description=Handler bloc B-2: checks if name already registered]
INTEGRATION_STEP [step=9_bootstrap, description=First registration (name unknown): accept with signature proof]
INTEGRATION_STEP [step=9_rotation, description=Key rotation (name known, diff key): demand rotation_signature from Python]
INTEGRATION_STEP [step=10, description=Handler writes to registre: arc.lock().await.register(card)]
INTEGRATION_STEP [step=11, description=Handler responds: purpose=agent_register_ack]
INTEGRATION_STEP [step=12, description=Python receives ack: agent.registered = true]
INTEGRATION_STEP [step=13, description=Python sends signed communication via send_message]
INTEGRATION_STEP [step=14, description=Rust verifies signature + checks registre public_key matches]
INTEGRATION_STEP [step=15, description=Rust routes to peer or stores in adn_store chain]

