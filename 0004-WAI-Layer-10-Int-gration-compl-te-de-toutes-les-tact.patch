+// ============================================================================
+// 8. SEMANTIC ONTOLOGY COMPRESSION — Remplacement par pointeurs sémantiques
+// ============================================================================
+
+#[derive(Clone, Serialize, Deserialize)]
+pub struct SemanticOntology {
+    /// Concepts métier (agent, registry, signature, etc.)
+    concepts: Vec<String>,
