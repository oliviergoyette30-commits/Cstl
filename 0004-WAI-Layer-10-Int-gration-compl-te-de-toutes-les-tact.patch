+    pub fn encode(&mut self, symbol: u8) -> u8 {
+        let pos = self.symbols.iter().position(|&s| s == symbol).unwrap() as u8;
+        self.symbols.remove(pos as usize);
+        self.symbols.insert(0, symbol);
+        pos
+    }
