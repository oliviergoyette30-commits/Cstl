      benefit: "Database grows bounded (e.g., keep last 1M messages, archive older)"
    },

    async_tokio_migration: {
      description: "Replace per-connection threads with async/await (tokio)",
      effort: "3 weeks",
      benefit: "Handle 10k concurrent connections (vs ~1k today)"
    },

