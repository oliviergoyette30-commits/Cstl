    attack_scenario: "Attacker sends 1M messages/sec to exhaust server",
    cstl_mitigation_v5_0_0: "NONE",
    proposed_v5_1: "Rate limit per IP (1000 msgs/min), per agent (500 msgs/min), per purpose (100 agent_register/hour)",
    proof_of_work: "24-bit PoW on agent_register to raise attacker cost"
  },

  owasp_asi05_unrestricted_resource_consumption: {
    name: "Unbounded Resource Consumption",
    cstl_exposure: "HIGH (message size unlimited, database unbounded)",
    attack_scenario: "Attacker sends 1GB payload => server OOM",
    cstl_mitigation_v5_0_0: "NONE",
    proposed_v5_1: "Message size limit (e.g., 10 MB), ADN Store checkpointing (keep last 1M messages)"
  },

  owasp_asi06_weak_model_isolation: {
    name: "Weak Isolation Between LLM Tasks",
    cstl_exposure: "MEDIUM (alice, bob, charlie each in separate OS processes)",
    current_isolation: "Process-level isolation (good), no cryptographic compartmentalization",
    risk: "If one agent compromised, others still safe (different process)"
  },

  owasp_asi07_insecure_inter_agent_communication: {
    name: "Insecure Communication Between Agents",
    cstl_exposure: "HIGH (before v5.0.0: TCP clear text, unsigned messages)",
    cstl_mitigation_v5_0_0: "✅ Ed25519 signatures (sender authenticity), no transport encryption",
    residual_risk: "TCP clear text (eavesdropping possible)",
    proposed_v5_1: "TLS mutual authentication + AES-256-GCM encryption"
  },

  owasp_asi08_insufficient_logging_monitoring: {
    name: "Insufficient Logging & Monitoring",
    cstl_exposure: "MEDIUM (basic audit trail exists, no alerting)",
    cstl_mitigation_v5_0_0: "✅ Full SHA-256 hash-chain audit trail in ADN Store",
    limitation: "No real-time alerting (alerts require external monitoring system)"
  },

  owasp_asi09_improper_exception_handling: {
    name: "Improper Exception Handling",
    cstl_exposure: "LOW (Rust enforces Result<> types, hard to ignore errors)",
    rust_advantage: "Compiler prevents unwrap() without explicit error handling"
  },

  owasp_asi10_unsafe_consumption_of_untrusted_data: {
    name: "Unsafe Parsing of Untrusted Input",
    cstl_exposure: "MEDIUM (parser processes untrusted CSTL text)",
    attack_scenario: "Malformed CSTL payload => parser crash or memory corruption",
    cstl_mitigation_v5_0_0: "✅ NFC canonicalization (prevents homograph attacks)",
    limitation: "No formal input validation (regex-based, not grammar-based)",
    proposed_v5_1: "Formal parser (pest or nom) instead of regex for bulletproof parsing"
  },

  summary_v5_0_0: {
    vulnerabilities_addressed: 2_out_of_10 [ASI03_Identity, ASI07_Communication],
    vulnerabilities_mitigated: 5_out_of_10 [ASI01_via_agent_prompt_guard, ASI06_via_process_isolation, ASI08_via_audit_trail, ASI09_via_rust_type_system, ASI10_via_nfc],
    vulnerabilities_open: 3_out_of_10 [ASI02_implicit, ASI04_no_rate_limit, ASI05_unbounded_resource],
    verdict_v5_0_0: "Production-ready for INTERNAL communication (trusted network), NOT for public internet"
  }
]

---SECTION_INNOVATIONS_DIFFERENTIATEURS---

TECHNICAL_INNOVATIONS [
  heading: "Avances Uniques et Différentiateurs de CSTL v5.0.0",

  innovation_1_deterministic_canonicalization: {
    name: "Canonical CSTL Format (NFC + BTreeMap Sort)",
    uniqueness: "No existing protocol combines Unicode NFC normalization + sorted key canonicalization",
    benefit_1: "Enables Ed25519 signatures on text format (usually binary protocols only)",
    benefit_2: "Prevents homograph attacks (é vs e+combining acute)",
    benefit_3: "Human-readable signed messages (debug-friendly)",
    trade_off: "Storage overhead vs binary formats (text is 2-3x larger)"
  },

  innovation_2_layered_architecture: {
    name: "9-Layer Architecture (cryptography, governance, audit, compression)",
    uniqueness: "Explicit layering with backward compatibility (can deploy layers incrementally)",
    comparison_others: "Most protocols conflate layers (e.g., HTTP/TLS = transport + crypto)",
    benefit: "Architectural clarity, testability (each layer independent)"
  },

  innovation_3_bootstrap_self_signing: {
    name: "Agent Self-Signature for Bootstrap Registration",
    mechanism: "New agent signs its own public key to prove possession of private key",
    uniqueness: "No PKI/CA required (contrast: traditional TLS requires CA certificate)",
    benefit_1: "Decentralized registration (no single point of trust)",
    benefit_2: "Suitable for ad-hoc agent networks",
    limitation: "Only proves key ownership, not identity; subject name verification needed elsewhere"
  },

  innovation_4_quorum_deontic_voting: {
    name: "Byzantine Quorum + Deontic Logic Constraints",
    combination: "Byzantine consensus (2/3 majority) + explicit protocol constraints (Obligations/Permissions/Prohibitions)",
    uniqueness: "Deontic logic rarely appears in protocol voting (more common in philosophy/normative theory)",
    benefit: "Governance becomes explicit and auditable (constraint violations are protocol errors, not just policy)"
  },

  innovation_5_hash_chain_audit_trail: {
    name: "Append-Only Hash-Chain with Full History Replay",
    mechanism: "Each message includes PARENT_HASH = SHA-256(previous message)",
    comparison_blockchain: "Similar to blockchain, but centralized (single server), no consensus on chain validity",
    benefit: "Tamper evidence + full history reconstructable",
    use_case: "Forensics, compliance auditing (prove when action occurred and who signed)"
  },

  innovation_6_language_agnostic_signing: {
    name: "Ed25519 Signatures Verified Across Rust + Python",
    implementation: "Same signing_bytes() logic in both languages",
    uniqueness: "Most multi-language systems struggle with deterministic signing; CSTL achieves it",
    test_evidence: "Cross-language smoke tests verify Rust signature can be verified by Python (and vice versa)",
    benefit: "Agents written in any language can interoperate securely"
  ],

  innovation_7_compression_dictionary: {
    name: "CASTLE Layer 9: Deterministic Prefix Dictionary Compression",
    compression_ratio: "46.5% on typical payloads",
    uniqueness: "Custom dictionary tailored to CSTL protocol keywords",
    benefit: "Bandwidth/storage savings, still human-readable if compressed",
    limitation: "Fixed dictionary (no runtime adaptation)"
  ]
]

