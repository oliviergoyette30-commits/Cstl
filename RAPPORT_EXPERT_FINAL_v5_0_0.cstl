      "Tendermint — proven in Cosmos ecosystem, Byzantine, PoS-based",
      "Alea (Cambridge research) — randomized Byzantine protocol, good under asynchrony"
    ],

    trade_offs: {
      advantage: "No single point of trust (current server is SPoF)",
      disadvantage: "10-100x more complex, multiple rounds per consensus",
      recommendation: "Evaluate HotStuff first (simplest + production-proven)"
    }
  }
]

