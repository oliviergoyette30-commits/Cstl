    rec_3: "Establish key rotation policy (rotate agent keys every 90 days)",
    rec_4: "Monitor SQLite database size (alert if grows beyond 1GB)",
    rec_5: "Keep audit trail backups (weekly snapshot of cstl_adn.db)"
  },

  recommendations_before_production: {
