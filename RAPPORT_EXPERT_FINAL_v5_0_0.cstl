      description: "Replace Vec<AgentCard> with HashMap for O(1) lookup",
      effort: "2 days (simple refactor)",
      benefit: "Scalability to 10k+ agents"
    },

    adn_store_checkpointing: {
      description: "Implement snapshot checkpoints (every 100k messages), prune old history",
