      effort: "2 weeks",
      benefit: "Forward secrecy against quantum adversary"
    },

    post_quantum_kdf: {
      description: "Hybrid HMAC-SHA256 + ML-KEM (NIST FIPS 203 key encapsulation)",
      effort: "2 weeks",
      benefit: "Key agreement secure against quantum"
    }
  },

  v6_0_distributed_consensus: {
    timeline: "2028 (major revision)",

    description: "Upgrade from centralized server + hash-chain to true distributed Byzantine consensus",

    candidate_protocols: [
